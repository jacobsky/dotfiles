    "name": "jj-waltz",
    "version": "0.1.0",
    "min_herdr_version": "0.7.0",
    "description": "Create and remove jj-waltz workspaces from Herdr.",
    "manifest_path": "/home/jacobsky/dotfiles/.config/herdr/plugins/github/ezracerpac.jj-waltz-1b3af96734b4/plugins/herdr/herdr-plugin.toml",
